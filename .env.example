# =============================================================================
# ZOVIK AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Use this template to configure environment variables in local or production (Vercel)
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO GITHUB.
# =============================================================================

# --- AI Engine (Groq Cloud) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# --- Admin Authentication & Control Room ---
# Strong master password for the Owner / Admin Control Room (min 8 chars)
ADMIN_PASSWORD=your_secure_admin_password_here

# 32+ character cryptographic secret for signing admin session tokens (Strictly required >= 24 chars)
ADMIN_JWT_SECRET=your_random_32_character_jwt_secret_here

# Optional: Comma-separated list of trusted administrator emails
ADMIN_EMAILS=owner@example.com,admin@example.com

# --- User Session Security ---
USER_SESSION_SECRET=your_random_32_character_user_session_secret_here

# --- Supabase Database (Free Cloud PostgreSQL) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Firebase Client SDK Configuration ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- Firebase Admin SDK (Server-Side Operations & Token Verification) ---
# Project ID for Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id

# Service Account credentials for trusted server-side Firestore operations
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional alternative: Complete service account JSON as a single-line string
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
